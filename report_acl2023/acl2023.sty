% Minimal ACL 2023-like style for a compact project report.
% This is intentionally self-contained so the zip can be imported directly.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{acl2023}[2026/06/12 Compact ACL 2023-like report style]

\newif\ifacl@review
\DeclareOption{review}{\acl@reviewtrue}
\DeclareOption{final}{\acl@reviewfalse}
\ProcessOptions\relax

\RequirePackage[a4paper,top=2.5cm,bottom=2.5cm,left=2.2cm,right=2.2cm]{geometry}
\RequirePackage{times}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{abstract}

\setlength{\columnsep}{0.65cm}
\setlength{\parindent}{1em}
\setlength{\parskip}{0pt}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small CredChain project report}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.2ex plus .2ex}{0.8ex}
\titlespacing*{\subsection}{0pt}{1.0ex plus .2ex}{0.5ex}

\renewcommand{\maketitle}{%
  \begin{center}
    {\LARGE\bfseries \@title \par}
    \vspace{0.8em}
    {\normalsize \@author \par}
    \vspace{1.0em}
    \ifacl@review
      {\small ACL 2023-style project report draft}
    \else
      {\small ACL 2023-style project report}
    \fi
  \end{center}
  \vspace{0.8em}
}

\newenvironment{onecolabstract}
  {\begin{center}\begin{minipage}{0.92\textwidth}\small\textbf{Abstract}\quad}
  {\end{minipage}\end{center}\vspace{1.0em}}
